# Node
node_modules/
dist/
build/
storybook-static/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets — never commit these
.env
.env.*
!.env.example
.envrc

# Generated deployment artifacts
docker-compose.yml
docker-compose.test.yml
docker-compose.devbox.yml

# Python (infra/ tooling)
__pycache__/
*.py[codz]
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Editors / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# NOTE: keep patterns specific. A bare `lib/`, `var/`, or `target/` (as in the
# stock Python .gitignore template) silently swallows app source directories
# like apps/<name>/src/lib — do not reintroduce them.
