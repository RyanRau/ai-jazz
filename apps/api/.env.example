# Local dev: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://mono:mono@localhost:5432/mono

# Base64-encoded PKCS8 RSA private key. Generate with: npm run generate-keys
JWT_PRIVATE_KEY=

# Issuer claim on access tokens (prod: https://api.ryanzrau.dev)
JWT_ISSUER=http://localhost:3002

PORT=3002
