{
  "name": "bluestar",
  "version": "1.0.0",
  "description": "(Ozark) Bluestar a react component library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run typecheck && tsup",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "license": "ISC",
  "peerDependencies": {
    "goober": "^2.1.19",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@storybook/react": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "goober": "^2.1.19",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "10.5.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
